	"authors": [
		"PotatoSlayer56"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/armourhud",
		"source": "https://github.com/PotatoSlayer56/ArmourHUD",
		"discord": "https://discord.gg/M8rbaBSgRU"
